<?xml version="1.0"?>
<robot name="rear_axle_centered_car">
  <!-- 材料定义 -->
  <material name="body_white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="sensor_gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="center_red">
    <color rgba="1.0 0.0 0.0 1.0"/> <!-- 红色标记轨迹中心 -->
  </material>

  <!-- 1. 基准坐标系（base_link）：原点位于后轮轴中心（轨迹中心点） -->
  <link name="base_link">
    <visual>
      <origin xyz="1.35 0 0" rpy="0 0 0"/> <!-- 车身视觉模型相对于base_link的偏移：向前1.35m（轴距的一半） -->
      <geometry>
        <box size="4.5 1.8 1.5"/> <!-- 车长×车宽×车高不变 -->
      </geometry>
      <material name="body_white"/>
    </visual>
    <collision>
      <origin xyz="1.35 0 0" rpy="0 0 0"/> <!-- 碰撞模型与视觉模型位置一致 -->
      <geometry>
        <box size="4.5 1.8 1.5"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="1.35 0 0" rpy="0 0 0"/> <!-- 质心仍在车身中心（相对于base_link向前1.35m） -->
      <mass value="1500.0"/> <!-- 整备质量不变 -->
      <inertia ixx="3000.0" ixy="0.0" ixz="0.0"
               iyy="8000.0" iyz="0.0"
               izz="10000.0"/>
    </inertial>
  </link>

  <!-- 轨迹中心点标记（完整定义，确保被关节引用） -->
  <link name="track_center_marker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.1"/> <!-- 红色球体标记 -->
      </geometry>
      <material name="center_red"/>
    </visual>
    <!-- 无需碰撞和惯性属性（仅可视化） -->
  </link>

  <!-- 2. 车轮（后轮轴心为base_link原点） -->
  <!-- 2.1 左前轮（相对于后轮轴心的位置：轴距2.7m → X=2.7m） -->
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.2" radius="0.3"/> <!-- 尺寸不变 -->
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.2" radius="0.3"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0"
               iyy="0.5" iyz="0.0"
               izz="0.5"/>
    </inertial>
  </link>

  <!-- 2.2 右前轮 -->
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.2" radius="0.3"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.2" radius="0.3"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0"
               iyy="0.5" iyz="0.0"
               izz="0.5"/>
    </inertial>
  </link>

  <!-- 2.3 左后轮（位于base_link原点，X=0） -->
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.2" radius="0.3"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.2" radius="0.3"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0"
               iyy="0.5" iyz="0.0"
               izz="0.5"/>
    </inertial>
  </link>

  <!-- 2.4 右后轮 -->
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.2" radius="0.3"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.2" radius="0.3"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0"
               iyy="0.5" iyz="0.0"
               izz="0.5"/>
    </inertial>
  </link>

  <!-- 3. 传感器（位置相对于base_link调整） -->
  <!-- 3.1 激光雷达（车顶前端：车身中心向前1.15m → 相对于base_link向前1.35+1.15=2.5m） -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.1"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
               iyy="0.01" iyz="0.0"
               izz="0.01"/>
    </inertial>
  </link>

  <!-- 3.2 前置摄像头（车头：相对于base_link向前2.7m+0.2m=2.9m） -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.05 0.05"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <!-- 3.3 IMU（车身中心：相对于base_link向前1.35m） -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0"
               iyy="0.0005" iyz="0.0"
               izz="0.0005"/>
    </inertial>
  </link>

  <!-- 4. 关节定义（新增轨迹中心标记的固定关节） -->
  <!-- 轨迹中心标记关节（引用已定义的track_center_marker） -->
  <joint name="track_center_joint" type="fixed">
    <parent link="base_link"/>
    <child link="track_center_marker"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 4. 关节定义（核心调整：后轮在base_link原点，前轮位置基于轴距计算） -->
  <!-- 4.1 前轮转向关节（X=2.7m，即轴距） -->
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="2.7 0.775 -0.75" rpy="0 0 0"/> <!-- X=2.7m（轴距），Y=0.775m（轮距一半） -->
    <axis xyz="0 0 1"/> <!-- 绕Z轴转向 -->
    <limit lower="-0.6109" upper="0.6109" effort="200" velocity="5"/> <!-- ±35° -->
  </joint>

  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="2.7 -0.775 -0.75" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6109" upper="0.6109" effort="200" velocity="5"/>
  </joint>

  <!-- 后轮驱动关节（左右后轮分别在轨迹中心Y±0.775m处） -->
  <joint name="rear_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="0 0.775 -0.75" rpy="0 0 0"/> <!-- 轨迹中心右侧0.775m -->
    <axis xyz="0 1 0"/>
    <limit effort="300" velocity="10"/>
  </joint>

  <joint name="rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="0 -0.775 -0.75" rpy="0 0 0"/> <!-- 轨迹中心左侧0.775m -->
    <axis xyz="0 1 0"/>
    <limit effort="300" velocity="10"/>
  </joint>

  <!-- 4.3 传感器关节（位置相对于base_link调整） -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="2.5 0 0.75" rpy="0 0 0"/> <!-- 车顶前端 -->
  </joint>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="2.9 0 0.5" rpy="0 0 0"/> <!-- 车头中部 -->
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="1.35 0 0" rpy="0 0 0"/> <!-- 车身中心 -->
  </joint>

  <!-- 5. 传动配置（与之前一致，适配ros2_control） -->
  <transmission name="rear_left_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_left_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_left_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="rear_right_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_right_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_right_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="front_left_steering_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_left_steering_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_left_steering_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="front_right_steering_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_right_steering_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_right_steering_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
</robot>
